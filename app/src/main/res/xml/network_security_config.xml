<?xml version="1.0" encoding="utf-8"?>
<!-- Pertahanan berlapis: walau aplikasi tidak punya izin internet, cleartext tetap dilarang. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
